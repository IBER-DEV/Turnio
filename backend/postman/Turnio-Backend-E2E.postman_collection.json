            {
              "key": "token",
              "value": "{{carlos_access}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "    pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "    const data = pm.response.json();",
              "    const anaEmail = pm.collectionVariables.get(\"ana_email\");",
              "    const ana = data.find(m => m.email === anaEmail);",
              "    pm.test(\"Ana está en la lista de empleados\", () => pm.expect(ana).to.not.be.undefined);",
              "    if (ana) pm.collectionVariables.set(\"ana_id\", ana.id);",
              "})();"
            ]
          }
        }
      ]
