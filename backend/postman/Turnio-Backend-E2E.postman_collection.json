  "item": [
    {
      "name": "1. Registrar Barbería El Corte (dueño + empleada Ana)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/negocios/registro/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "negocios",
            "registro",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_negocio\": \"Barbería El Corte\",\n  \"ciudad\": \"Bogotá\",\n  \"email_dueno\": \"{{carlos_email}}\",\n  \"nombre_dueno\": \"Carlos Dueño\",\n  \"password_dueno\": \"claveSegura123\",\n  \"empleados\": [\n    {\n      \"email\": \"{{ana_email}}\",\n      \"nombre\": \"Ana\",\n      \"password\": \"claveSegura123\",\n      \"especialidad\": \"Barbera\",\n      \"puede_gestionar_agenda\": true\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "    // Emails únicos por corrida: la colección queda re-ejecutable sin",
              "    // chocar con datos de una corrida anterior (el backend rechaza",
              "    // emails duplicados con 400).",
              "    const runId = Date.now();",
              "    pm.collectionVariables.set(\"run_id\", runId);",
              "    pm.collectionVariables.set(\"carlos_email\", `carlos.${runId}@elcorte.com`);",
              "    pm.collectionVariables.set(\"ana_email\", `ana.${runId}@elcorte.com`);",
              "    pm.collectionVariables.set(\"otro_dueno_email\", `duena.${runId}@otrosalon.com`);",
              "    ",
              "    // Fecha de la cita: el próximo lunes a partir de hoy (coincide con el",
              "    // horario que se carga más abajo, dia_semana=0). No hace falta variarla",
              "    // entre corridas: cada corrida crea una Ana nueva (email único arriba),",
              "    // así que nunca hay un choque de disponibilidad con una corrida anterior.",
              "    const hoy = new Date();",
              "    let diasHastaLunes = (1 - hoy.getDay() + 7) % 7;",
              "    if (diasHastaLunes === 0) diasHastaLunes = 7;",
              "    const fechaCita = new Date(hoy);",
              "    fechaCita.setDate(hoy.getDate() + diasHastaLunes);",
              "    const yyyy = fechaCita.getFullYear();",
              "    const mm = String(fechaCita.getMonth() + 1).padStart(2, \"0\");",
              "    const dd = String(fechaCita.getDate()).padStart(2, \"0\");",
              "    pm.collectionVariables.set(\"fecha_cita\", `${yyyy}-${mm}-${dd}T10:00:00`);",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "    pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "    const data = pm.response.json();",
              "    pm.collectionVariables.set(\"carlos_access\", data.access);",
              "    pm.collectionVariables.set(\"carlos_refresh\", data.refresh);",
              "    pm.test(\"Devuelve tokens\", () => {",
              "        pm.expect(data.access).to.be.a(\"string\");",
              "        pm.expect(data.refresh).to.be.a(\"string\");",
              "    });",
              "})();"
            ]
          }
        }
      ]
    },
