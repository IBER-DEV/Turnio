# Opcional en desarrollo: si no se define, el cliente HTTP le habla al
# puerto 8001 del MISMO host desde el que se sirvió la app
# (ver `src/api/client.ts`). Eso hace que abrir la app desde un celular
# de la red local funcione sin configurar nada.
#
# Definirla solo hace falta cuando el backend NO vive en el puerto 8001
# del mismo host — el caso del despliegue real.
# VITE_API_BASE_URL=https://api.turnio.app
